---
import Divider from './Divider.astro'
import Content from './Content.astro'
import Inner from './Inner.astro'
import Icon from './Icon.astro'
import { iconpos } from '../lib/utils'
import { getEntry, render } from 'astro:content'

interface Props {
  offset: number
  factor?: number
}

const { offset, factor = 1 } = Astro.props
const aboutEntry = await getEntry('Sections', 'about')

if (!aboutEntry) {
  throw new Error('Sections entry "about" not found')
}

const { Content: AboutSection } = await render(aboutEntry)

import CoffeeIcon from '../assets/icons/coffee.svg'
import ReadingIcon from '../assets/icons/reading.svg'
import SunglassesIcon from '../assets/icons/sunglasses.svg'
import WebsiteIcon from '../assets/icons/website.svg'
import WineIcon from '../assets/icons/wine.svg'
import PhotoIcon from '../assets/icons/photo.svg'
import BooksIcon from '../assets/icons/books.svg'
import PawIcon from '../assets/icons/paw-print.svg'
import DogIcon from '../assets/icons/dog.svg'
import FlowerIcon from '../assets/icons/flower.svg'
import RubikIcon from '../assets/icons/Rubik.svg'
import FloralSpringBackground from '../assets/backgrounds/floral-spring.svg'
---

<div>
  <Divider bg="var(--color-divider)" clipPath="polygon(0 16%, 100% 4%, 100% 82%, 0 94%)" speed={0.2} offset={offset} factor={factor} />
  <Divider speed={0.1} offset={offset} factor={factor} class="pointer-events-none">
    <img
      src={FloralSpringBackground.src}
      alt="about background"
      class="fixed top-0 left-0 w-full opacity-10"
    />
    <div class="absolute inset-0 animate-[up-down_4s_ease-in-out_infinite_alternate]">
      <Icon src={PawIcon} style={iconpos(64, '50%', '75%')} hiddenMobile />
      <Icon src={CoffeeIcon} style={iconpos(32, '60%', '20%')} hiddenMobile />
      <Icon src={ReadingIcon} style={iconpos(16, '25%', '5%')} />
      <Icon src={SunglassesIcon} style={iconpos(16, '80%', '80%')} hiddenMobile />
    </div>
    <div class="absolute inset-0 animate-[up-down-wide_18s_ease-in-out_infinite_alternate]">
      <Icon src={RubikIcon} style={iconpos(48, '5%', '80%')} hiddenMobile />
      <Icon src={WineIcon} style={iconpos(16, '95%', '50%')} />
      <Icon src={PhotoIcon} style={iconpos(16, '85%', '15%')} hiddenMobile />
      <Icon src={BooksIcon} style={iconpos(16, '45%', '10%')} hiddenMobile />
    </div>
    <Icon src={FlowerIcon} style={iconpos(16, '4%', '20%')} hiddenMobile />
    <Icon src={DogIcon} style={iconpos(16, '10%', '10%')} />
    <Icon src={WebsiteIcon} style={iconpos(16, '80%', '70%')} />
  </Divider>
  <Content speed={0.4} offset={offset} factor={factor}>
    <Inner>
      <AboutSection />
    </Inner>
  </Content>
</div>
