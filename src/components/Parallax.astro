---
interface Props {
  pages: number
}
const { pages } = Astro.props
---

<div
  data-parallax-container
  style="height: 100dvh; min-height: 100vh; overflow-y: auto; overflow-x: hidden; position: relative; overscroll-behavior-y: contain; -webkit-overflow-scrolling: touch; touch-action: pan-y;"
>
  <div style={`height: ${pages * 100}vh; position: relative;`}>
    <slot />
  </div>
</div>

<script>
  import { initParallax } from '../scripts/parallax'
  initParallax()
</script>
