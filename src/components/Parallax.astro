---
interface Props {
  pages: number
}
const { pages } = Astro.props
---

<div
  data-parallax-container
  class="relative h-dvh min-h-screen touch-pan-y overflow-x-hidden overflow-y-auto overscroll-y-contain"
  style="-webkit-overflow-scrolling: touch;"
>
  <div style={`height: ${pages * 100}vh; position: relative;`}>
    <slot />
  </div>
</div>

<script>
  import { initParallax } from '../scripts/parallax'
  initParallax()
</script>
