---
import Divider from './Divider.astro'
import Content from './Content.astro'
import Inner from './Inner.astro'
import Icon from './Icon.astro'
import { iconpos } from '@/lib/utils'
import ProjectsMDX from '@/sections/projects.mdx'
import ProjectCard from './ProjectCard.astro'

interface Props {
  offset: number
  factor?: number
}

const { offset, factor = 2 } = Astro.props

import WrenchIconRaw from '@/assets/icons/adjustable-wrench.svg?raw'
import RubikIconRaw from '@/assets/icons/Rubik.svg?raw'
import BlueprintIconRaw from '@/assets/icons/blueprint.svg?raw'
import AtomIconRaw from '@/assets/icons/atom.svg?raw'
import PuzzleIconRaw from '@/assets/icons/puzzle.svg?raw'
import CloudIconRaw from '@/assets/icons/computing-cloud.svg?raw'
import FolderIconRaw from '@/assets/icons/folders.svg?raw'
import GearsIconRaw from '@/assets/icons/gears.svg?raw'
import GraphicsIconRaw from '@/assets/icons/graphics.svg?raw'
import NotebookIconRaw from '@/assets/icons/notebook2.svg?raw'
import WorkflowIconRaw from '@/assets/icons/workflow.svg?raw'
import CalculatorIconRaw from '@/assets/icons/calculator.svg?raw'
import ChipIconRaw from '@/assets/icons/chip.svg?raw'
import CompassIconRaw from '@/assets/icons/compass.svg?raw'
import ProgrammingIconRaw from '@/assets/icons/programming.svg?raw'
---

<div>
  <Divider
    bg="linear-gradient(to right, #f7caca 0%, #93a9d1 100%)"
    clipPath="polygon(0 15%, 100% 25%, 100% 85%, 0 75%)"
    speed={-0.2}
    offset={1.1}
    factor={factor}
  />
  <Divider speed={0.1} offset={offset} factor={factor} class="pointer-events-none">
    <img
      src="/backgrounds/river.svg"
      alt="projects background"
      class="fixed top-[25%] left-0 w-full opacity-30"
    />
    <div class="animate-up-down">
      <Icon src={WrenchIconRaw} style={iconpos(16, '85%', '75%')} />
      <Icon src={RubikIconRaw} style={iconpos(16, '70%', '20%')} />
      <Icon src={BlueprintIconRaw} style={iconpos(48, '25%', '5%')} />
      <Icon src={PuzzleIconRaw} style={iconpos(16, '17%', '60%')} />
    </div>
    <div class="animate-up-down-wide">
      <Icon src={AtomIconRaw} style={iconpos(64, '20%', '90%')} />
      <Icon src={CloudIconRaw} style={iconpos(16, '90%', '30%')} />
      <Icon src={FolderIconRaw} style={iconpos(48, '70%', '90%')} />
      <Icon src={GearsIconRaw} style={iconpos(48, '18%', '75%')} />
      <Icon src={GraphicsIconRaw} style={iconpos(16, '75%', '10%')} />
      <Icon src={NotebookIconRaw} style={iconpos(48, '45%', '10%')} />
    </div>
    <Icon src={WorkflowIconRaw} style={iconpos(16, '4%', '20%')} />
    <Icon src={CompassIconRaw} style={iconpos(16, '80%', '60%')} />
    <Icon src={ProgrammingIconRaw} style={iconpos(16, '10%', '10%')} />
    <Icon src={BlueprintIconRaw} style={iconpos(16, '29%', '26%')} />
    <Icon src={CalculatorIconRaw} style={iconpos(16, '75%', '30%')} />
    <Icon src={ChipIconRaw} style={iconpos(16, '80%', '70%')} />
  </Divider>
  <Content speed={0.4} offset={offset + 0.2} factor={factor}>
    <Inner>
      <div class="projects-grid grid grid-cols-1 gap-2 xs:gap-8 sm:grid-cols-2 md:gap-16">
        <ProjectsMDX components={{ ProjectCard }} />
      </div>
    </Inner>
  </Content>
</div>
