---
import { HIDDEN_MOBILE_CLASS, styleToString } from '@/lib/utils'

interface Props {
  src: string
  style?: Record<string, string | number> | string
  class?: string
  hiddenMobile?: boolean
}

const { src, style, class: className = '', hiddenMobile = false } = Astro.props

const styleStr = styleToString(style)
const classAttr = [className, hiddenMobile ? HIDDEN_MOBILE_CLASS : ''].filter(Boolean).join(' ')

// Inject style and class into the root <svg> element
let svgContent = src
// Remove XML declaration if present
svgContent = svgContent.replace(/<\?xml[^>]*\?>\s*/g, '').trim()
// Inject attributes into the opening <svg ...> tag
svgContent = svgContent.replace(/^<svg(\s[^>]*)?>/, (_match, attrs = '') => {
  let newAttrs = attrs
  if (styleStr) {
    // Append to existing style or add new
    if (/style="/.test(newAttrs)) {
      newAttrs = newAttrs.replace(/style="([^"]*)"/, `style="$1; ${styleStr}"`)
    } else {
      newAttrs += ` style="${styleStr}"`
    }
  }
  if (classAttr) {
    if (/class="/.test(newAttrs)) {
      newAttrs = newAttrs.replace(/class="([^"]*)"/, `class="$1 ${classAttr}"`)
    } else {
      newAttrs += ` class="${classAttr}"`
    }
  }
  return `<svg${newAttrs}>`
})
---

<Fragment set:html={svgContent} />
