---
import { styleToString } from '../lib/utils'
import type { SvgComponent } from 'astro/types'

interface Props {
  src: SvgComponent
  style?: Record<string, string | number> | string
  class?: string
  hiddenMobile?: boolean
}

const { src, style, class: className = '', hiddenMobile = false } = Astro.props

const styleStr = styleToString(style)
const classAttr = [className, hiddenMobile ? 'hidden sm:block' : ''].filter(Boolean).join(' ')
const SvgIcon = src
---

<SvgIcon style={styleStr || undefined} class={classAttr || undefined} />
