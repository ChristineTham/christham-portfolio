---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  link: string
  title: string
  children?: unknown
  image: ImageMetadata
  bg: string
}

const { link, title, image, bg } = Astro.props
---

<a
  href={link}
  target="_blank"
  rel="noreferrer noopener"
  class="relative block w-full rounded-lg px-4 py-2 text-white no-underline shadow-lg transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl sm:px-8 sm:py-4"
  style={`background: ${bg || 'none'};`}
>
  <div class="aspect-video w-full overflow-hidden rounded-md bg-white/10">
    <Image
      src={image}
      alt={title}
      width="960"
      height="540"
      loading="lazy"
      class="size-full object-contain"
    />
  </div>
  <div class="pt-2 text-2xl leading-none font-medium tracking-wide sm:text-3xl">
    {title}
  </div>
  <div class="text-sm opacity-80 sm:text-base">
    <slot />
  </div>
</a>
