---
import Divider from './Divider.astro'
import Content from './Content.astro'
import Inner from './Inner.astro'
import Icon from './Icon.astro'
import Footer from './Footer.astro'
import { iconpos } from '../lib/utils'
import { getEntry, render } from 'astro:content'

interface Props {
  offset: number
  factor?: number
}

const { offset, factor = 1 } = Astro.props
const contactEntry = await getEntry('Sections', 'contact')

if (!contactEntry) {
  throw new Error('Sections entry "contact" not found')
}

const { Content: ContactSection } = await render(contactEntry)

import AgendaIcon from '../assets/icons/agenda.svg'
import CheckListIcon from '../assets/icons/check-list.svg'
import EmailIcon from '../assets/icons/email.svg'
import PhoneIcon from '../assets/icons/smartphone.svg'
import IDCardIcon from '../assets/icons/id-card.svg'
import MapIcon from '../assets/icons/map.svg'
import MessageIcon from '../assets/icons/message.svg'
import SendIcon from '../assets/icons/send.svg'
import PostItIcon from '../assets/icons/post-it.svg'
import LakeBackground from '../assets/backgrounds/lake.svg'
---

<div>
  <Divider fill="#be9cc1" speed={0.2} offset={offset} factor={factor}>
    <div class="absolute bottom-0 w-full -scale-y-100">
      <div class="relative h-full">
        <svg xmlns="http://www.w3.org/2000/svg" id="contact-wave" viewBox="0 0 800 338.05" preserveAspectRatio="none" class="h-96 w-full fill-current">
          <path>
            <animate
              attributeName="d"
              values={`M 0 100 Q 250 50 400 200 Q 550 350 800 300 L 800 0 L 0 0 L 0 100 Z;
              M 0 100 Q 200 150 400 200 Q 600 250 800 300 L 800 0 L 0 0 L 0 100 Z;
              M 0 100 Q 150 350 400 200 Q 650 50 800 300 L 800 0 L 0 0 L 0 100 Z`}
              repeatCount="indefinite"
              dur="30s"
            />
          </path>
        </svg>
      </div>
    </div>
  </Divider>
  <Divider speed={0.1} offset={offset} factor={factor} class="pointer-events-none">
    <img
      src={LakeBackground.src}
      alt="contact background"
      class="fixed top-10 left-0 w-full opacity-20"
    />
    <div class="absolute inset-0 animate-[up-down_4s_ease-in-out_infinite_alternate]">
      <Icon src={AgendaIcon} style={iconpos(16, '70%', '20%')} hiddenMobile />
      <Icon src={CheckListIcon} style={iconpos(16, '25%', '5%')} />
    </div>
    <div class="absolute inset-0 animate-[up-down-wide_18s_ease-in-out_infinite_alternate]">
      <Icon src={EmailIcon} style={iconpos(16, '95%', '50%')} />
      <Icon src={PhoneIcon} style={iconpos(16, '85%', '15%')} />
      <Icon src={IDCardIcon} style={iconpos(48, '45%', '10%')} hiddenMobile />
    </div>
    <Icon src={MapIcon} style={iconpos(16, '4%', '20%')} />
    <Icon src={MessageIcon} style={iconpos(16, '70%', '60%')} />
    <Icon src={SendIcon} style={iconpos(16, '20%', '25%')} />
    <Icon src={PostItIcon} style={iconpos(16, '80%', '70%')} />
  </Divider>
  <Content speed={0.4} offset={offset} factor={factor}>
    <Inner class="max-w-4xl">
      <div class="prose max-w-none prose-headings:text-(--color-heading) prose-p:text-(--color-text) prose-a:text-(--color-primary) prose-blockquote:text-(--color-heading) prose-strong:text-(--color-heading) prose-li:text-(--color-text)">
        <ContactSection />
      </div>
    </Inner>
    <Footer />
  </Content>
</div>
